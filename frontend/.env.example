# =====================================================================
# DP Cell Salary Management System — FRONTEND configuration (EXAMPLE)
#
# Copy to frontend/.env. Vite reads VITE_* variables at BUILD time, so a
# production build must be run with the production value set.
# PLACEHOLDERS ONLY — never commit real hosts or secrets.
#
# NOTE: anything in a VITE_* variable is embedded in the browser bundle
# and is therefore public. Never put a secret here.
# =====================================================================

# Base URL of the backend API, without a trailing slash.
# Every request appends its own "/api/..." path to this value.
VITE_API_BASE_URL=http://localhost:5000
