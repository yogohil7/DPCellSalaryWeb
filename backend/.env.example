# =====================================================================
# DP Cell Salary Management System — BACKEND configuration (EXAMPLE)
#
# Copy to backend/.env and fill in real values for your machine.
# PLACEHOLDERS ONLY — never commit real secrets or credentials.
# =====================================================================

# --- SQL Server -------------------------------------------------------
# Leave DB_USER and DB_PASSWORD empty to keep Windows authentication
# (Trusted_Connection), which is how this project has always connected.
DB_SERVER=YOUR-SQL-SERVER
DB_DATABASE=YOUR-DATABASE-NAME
DB_PORT=
DB_USER=
DB_PASSWORD=

# --- Authentication ---------------------------------------------------
# REQUIRED. The server refuses to start without it: there is no built-in
# fallback, by design. Use a long random string (32+ characters) and keep
# it stable — changing it invalidates every issued token.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret-min-16-chars
JWT_EXPIRES_IN=8h

# --- CORS -------------------------------------------------------------
# Comma-separated allowlist of browser origins permitted to call this API.
# No wildcards. Production names its real frontend origin here.
CORS_ORIGIN=http://localhost:5173

# --- Server -----------------------------------------------------------
PORT=5000

# --- Bootstrap admin (OPTIONAL) ---------------------------------------
# Only set this when you need the server to create the initial "admin"
# account, or to repair an admin whose stored password hash is missing or
# corrupt. Leave it EMPTY on an established installation.
#
# When empty, the server creates no account and writes no password.
# When set, an existing VALID password hash is still never overwritten:
# bootstrap is not a password-reset mechanism.
# PLACEHOLDER ONLY — put the real value in backend/.env, never here.
BOOTSTRAP_ADMIN_PASSWORD=
