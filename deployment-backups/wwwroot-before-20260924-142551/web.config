<?xml version="1.0" encoding="UTF-8"?>
<!--
  DP Cell Salary Management - IIS site configuration.

  Serves the React build and reverse-proxies the API so the browser only ever
  talks to ONE origin (this IIS site, port 80). Nothing here contains a LAN IP,
  so a change of server address needs no edit and no rebuild.

      Browser  ->  http://<server>/            -> React static files
      Browser  ->  http://<server>/api/...     -> IIS -> http://127.0.0.1:5000/api/...

  REQUIRES on the server (see the deployment notes):
    - IIS URL Rewrite 2.1
    - Application Request Routing 3.0, with the ARR proxy ENABLED at server
      level (IIS Manager -> server node -> Application Request Routing Cache
      -> Server Proxy Settings -> tick "Enable proxy"). That switch lives in
      applicationHost.config and CANNOT be set from this file.
-->
<configuration>
  <system.webServer>

    <!--
      index.html must win. <clear/> removes any inherited default document
      ordering, which is what lets a leftover iisstart.htm shadow the app.
    -->
    <defaultDocument>
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>

    <rewrite>
      <rules>
        <!--
          RULE 1 - API to Node.

          Runs first and stops, so an API call can never fall through to the
          SPA fallback below. 127.0.0.1 keeps the hop on the loopback
          interface: it does not depend on the server's LAN IP and does not
          require port 5000 to be reachable from the network.
        -->
        <rule name="ReverseProxyToNodeApi" stopProcessing="true">
          <match url="^api/(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:5000/api/{R:1}" />
        </rule>

        <!--
          RULE 2 - SPA fallback.

          Only for requests that are NOT a real file and NOT a real directory,
          so static assets are served normally and never rewritten. The
          explicit /api exclusion is belt-and-braces: rule 1 already stops
          those, and this guarantees no redirect loop if the rules are ever
          reordered.

          This app uses hash routing (#/page), so the fallback is rarely hit;
          it is kept so a direct path request still lands on the app instead
          of a 404.
        -->
        <rule name="SpaFallback" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
            <add input="{REQUEST_URI}" pattern="^/api/" negate="true" />
          </conditions>
          <action type="Rewrite" url="/index.html" />
        </rule>
      </rules>
    </rewrite>

    <!--
      index.html must not be cached, or a redeploy keeps serving the old
      bundle reference. The hashed asset files are immutable by name and are
      safe for the browser's normal caching.
    -->
    <caching>
      <profiles>
        <add extension=".html" policy="DisableCache" kernelCachePolicy="DisableCache" />
      </profiles>
    </caching>

  </system.webServer>
</configuration>
